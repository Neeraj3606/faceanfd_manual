# ─────────────────────────────────────
# FACE ATTENDANCE — ENVIRONMENT CONFIG
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# ─────────────────────────────────────

# App secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_generated_secret_key_here

# Database (SQLite - no setup needed)
DATABASE_URL=sqlite:///data/attendance.db

# Face Recognition Settings
MATCH_THRESHOLD=0.65

# Anti-Spoofing Settings
LIVENESS_ENABLED=true
MINIFASNET_REAL_THRESHOLD=0.20
MINIFASNET_CROP_SCALE=2.2
MINIFASNET_SCALES=2.0,2.5,3.0
MINIFASNET_MULTI_SCALE=true
LIVENESS_FAIL_CLOSED=true

# ─────────────────────────────────────
# AI INSIGHTS (Grok API) - Optional
# Get your key at: https://x.ai/
# ─────────────────────────────────────
GROK_API_KEY=
GROK_MODEL=grok-3

# ─────────────────────────────────────
# SECURITY
# ─────────────────────────────────────
# Super Admin secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SUPER_ADMIN_SECRET=your_generated_super_admin_secret_here

# CORS: comma-separated list of allowed origins
# For local dev: http://localhost:8000,http://127.0.0.1:8000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
